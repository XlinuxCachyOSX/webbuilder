{
  "name": "webbuilder",
  "version": "1.0.0",
  "private": true,
  "description": "Creatore di siti web drag & drop con generazione AI locale (Ollama). Zero dipendenze a runtime.",
  "keywords": [
    "website-builder",
    "drag-and-drop",
    "ollama",
    "ai",
    "vanilla-js",
    "static-site"
  ],
  "license": "MIT",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "serve": "python3 -m http.server 8000",
    "test": "node --test",
    "lint:js": "node --check app.js",
    "lint:html": "html-validate index.html",
    "lint": "npm run lint:js && npm run lint:html"
  },
  "devDependencies": {
    "html-validate": "^9.0.0"
  }
}
